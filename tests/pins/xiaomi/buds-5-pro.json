{
  "model": "Xiaomi Buds 5 Pro",
  "owner": "KentoNion",
  "bridge": "xiaomi-bridge",
  "notes": "Compact GAIA on SPP, PR #1. Off and ANC were confirmed from the panel; Ambient is 0x02, the byte whose GET payload was seen and whose SET did not drop the link. 0x04 reboots the buds and is never sent.",
  "session": {},
  "steps": [
    {
      "call": "open",
      "note": "the channel is up: the handshake goes out at once, version 3"
    },
    {
      "sent": [
        "ff 03 00 00 00 0a 03 00"
      ]
    },
    {
      "timers": [
        2000
      ],
      "note": "the handshake is repeated if unanswered"
    },
    {
      "device": "ff 03 00 04 00 0a 83 00 00 03 03 01",
      "note": "the handshake answer the buds gave"
    },
    {
      "sent": [
        "ff 03 00 00 00 0a 03 00",
        "ff 03 00 00 00 1d 10 03"
      ],
      "note": "then the listening-mode GET"
    },
    {
      "device": "ff 03 00 05 00 1d 11 03 01 01 01 00 00",
      "note": "GET answer: ANC"
    },
    {
      "lines": [
        {
          "modes": true,
          "mode": "anc",
          "available": [
            "off",
            "anc",
            "ambient"
          ]
        }
      ]
    },
    {
      "timers": [
        2000,
        3000,
        2500
      ],
      "note": "and from the first answer on, a poll every 2.5 s"
    },
    {
      "command": "set ambient"
    },
    {
      "sent_last": "ff 03 00 01 00 1d 10 04 02"
    },
    {
      "device": "ff 03 00 00 00 1d 11 04",
      "note": "SET ack: GET is what names the new state"
    },
    {
      "sent_last": "ff 03 00 00 00 1d 10 03"
    },
    {
      "device": "ff 03 00 05 00 1d 11 03 02 01 00 01 00"
    },
    {
      "line": {
        "modes": true,
        "mode": "ambient",
        "available": [
          "off",
          "anc",
          "ambient"
        ]
      }
    },
    {
      "command": "set talkthru",
      "note": "not a mode these buds have: nothing goes out"
    },
    {
      "command": "set off"
    },
    {
      "sent": [
        "ff 03 00 00 00 0a 03 00",
        "ff 03 00 00 00 1d 10 03",
        "ff 03 00 01 00 1d 10 04 02",
        "ff 03 00 00 00 1d 10 03",
        "ff 03 00 01 00 1d 10 04 00"
      ]
    },
    {
      "line_count": 2
    },
    {
      "exit": null
    }
  ]
}
